      aria-labelledby="screenshot-full-caption"
      closedby="any"
    >
      <button
        type="button"
        class="screenshot-close"
        commandfor="screenshot-dialog"
        command="close"
        autofocus
      >
        Close screenshot
      </button>
      <figure>
        <img id="screenshot-full" alt="" />
        <figcaption id="screenshot-full-caption"></figcaption>
      </figure>
    </dialog>
  </div>
  </section>"
`;

