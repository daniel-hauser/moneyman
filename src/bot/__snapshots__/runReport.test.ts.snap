exports[`renderHTMLReport shares search and download control sizing and interaction styles 1`] = `
[
  ".report-search,.download-button{box-sizing:border-box;appearance:none;height:2.25rem;border:1px solid #dadce0;border-radius:.375rem;background:#fff;color:#5f6368;line-height:1.25}",
  ".report-search{min-width:0;width:20rem;max-width:100%;padding:.375rem .5rem}",
  ".download-button,.sort-button{display:inline-flex;align-items:center;justify-content:center}",
  ".download-button{flex-shrink:0;width:2.25rem;padding:.375rem}",
  ".report-search:hover,.download-button:hover,.sort-button:hover{background:#f1f3f4;color:#202124}",
  ".report-search:focus-visible,.download-button:focus-visible,.sort-button:focus-visible{outline:2px solid #1a73e8;outline-offset:2px}",
]
`;

