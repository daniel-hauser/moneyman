            <th scope="col">Status</th>
            <th scope="col">Summary</th>
          </tr>
        </thead>
        <tbody>
          <tr class="storage-row">
                  <td>
                    Saving &lt;storage&gt;
                  </td>
                  <td>
                    ⏳ Saving
                  </td>
                  <td>—</td>
                </tr>
                <tr class="storage-detail-row">
                        <td colspan="3">
                          <ol class="storage-steps" aria-label="Storage steps">
                            <li>
                                    Loading &lt;data&gt;
                                  </li><li>
                                    Loaded (0.10s)
                                  </li>
                          </ol>
                        </td>
                      </tr><tr class="storage-row">
                  <td>
                    Failed
                  </td>
                  <td>
                    <details>
    <summary>❌ Failed</summary>
    <pre class="error-message">&lt;full error&gt;</pre>
  </details>
                  </td>
                  <td>—</td>
                </tr><tr class="storage-row">
                  <td>
                    Saved<small class="storage-table">Budget &lt;table&gt;</small>
                  </td>
                  <td>
                    ✅ Saved
                  </td>
                  <td>14 total · 2 added · 3 existing · 4 pending · 5 other skipped · 1.25s</td>
                </tr><tr class="storage-row">
                  <td>
                    Waiting
                  </td>
                  <td>
                    ⏳ Saving
                  </td>
                  <td>—</td>
                </tr>
        </tbody>
      </table>
    </div>
  </section>",
}
`;

