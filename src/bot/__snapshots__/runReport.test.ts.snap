          </thead>
          <tbody>
            <tr>
                  <td>2026-01-30T00:00:00.000Z</td>
                  <td>max</td>
                  <td>1234</td>
                  <td>Shop</td>
                  <td>10.00 ILS</td>
                  <td>completed</td>
                </tr>
          </tbody>
        </table>
      </div>
    </details>
  </section>
        <section>
    <h2>Storages</h2>
    <div class="report-grid">
      <article class="storage-result">
            <h3>Sheets</h3>
            <p class="storage-state">✅ Saved</p>
            <p>Table: TheTable</p>
                  <h4>Steps</h4>
