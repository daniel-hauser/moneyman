exports[`renderHTMLReport renders logs with whitespace and escaped markup 1`] = `
"<section>
    <div class="logs-heading section-heading">
      <h2>Logs</h2>
      <div class="heading-actions">
        <input
    id="search-logs"
    class="report-search"
    type="search"
    aria-label="Search logs"
    aria-controls="run-logs"
    placeholder="Search: * any text, ? one character"
    title="Case-insensitive: * any text, ? one character; ~* literal *, ~? literal ?, ~~ literal ~."
  />
        <button
    id="download-logs"
    class="download-button"
    type="button"
    aria-label="Download logs"
    title="Download logs"
    data-download="run-logs"
    data-filename="logs.txt"
    data-type="text/plain;charset=utf-8"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <use href="#download-icon" />
    </svg>
  </button>
      </div>
    </div>
    <pre id="run-logs" class="run-logs"><code>
  unique-log &lt;&amp;&gt; &quot;&lt;/pre&gt;&lt;script&gt;alert(1)&lt;/script&gt;&quot;&#13;
first&#13;second&#13;
	end</code></pre>
  </section>"
`;

